#!/usr/bin/env ruby
require "open3"
require "yaml"

root = File.expand_path("..", __dir__)
git_directory, git_status = Open3.capture2("git", "-C", root, "rev-parse", "--path-format=absolute", "--git-common-dir")
abort "Не найден Git-каталог проекта" unless git_status.success?
configuration_directory = File.join(git_directory.strip, "gh")
credentials_path = File.join(configuration_directory, "hosts.yml")
abort "Сначала выполни bin/gh-login" unless File.file?(credentials_path)
abort "У #{configuration_directory} должны быть права 700" unless (File.stat(configuration_directory).mode & 0o777) == 0o700
abort "У #{credentials_path} должны быть права 600" unless (File.stat(credentials_path).mode & 0o777) == 0o600

account = "serge-masiutin"
credentials = YAML.safe_load(File.read(credentials_path)).fetch("github.com")
abort "Аккаунт проекта должен быть #{account}" unless credentials.fetch("user") == account
token = credentials.fetch("users").fetch(account).fetch("oauth_token")
abort "Отсутствует токен проекта" unless token.is_a?(String) && !token.empty?

# Вход через обычный gh затрагивает общий macOS Keychain даже с GH_CONFIG_DIR.
if ARGV.first == "auth" && ARGV[1] != "status"
  abort "Для входа используй bin/gh-login; здесь разрешён только auth status"
end

executable = ENV.fetch("PATH").split(File::PATH_SEPARATOR).map { |directory| File.join(directory, "gh") }.find do |path|
  File.file?(path) && File.executable?(path) && !File.identical?(path, __FILE__)
end
abort "Установи GitHub CLI: https://cli.github.com" unless executable

environment = {
  "GH_CONFIG_DIR" => configuration_directory,
  "GH_TOKEN" => token,
  "GITHUB_TOKEN" => nil,
  "GH_ENTERPRISE_TOKEN" => nil,
  "GITHUB_ENTERPRISE_TOKEN" => nil,
  "GH_HOST" => "github.com",
  "GH_REPO" => "serge-masiutin/clear-writing",
  "GH_DEBUG" => nil,
  "DEBUG" => nil
}

login, error, status = Open3.capture3(environment, executable, "api", "user", "--jq", ".login", chdir: root)
abort "Не удалось проверить аккаунт проекта: #{error.strip}" unless status.success?
abort "GitHub вернул #{login.strip}; ожидался #{account}" unless login.strip == account

exec(environment, executable, *ARGV, chdir: root)
