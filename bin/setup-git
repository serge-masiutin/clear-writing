#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
key="$HOME/.ssh/id_ed25519_serge_masiutin_gh"
if [[ ! -f "$key" ]]; then
  echo "Не найден личный SSH-ключ: $key" >&2
  exit 1
fi

git -C "$root" config --local user.name 'Serge Masiutin'
git -C "$root" config --local user.email 'sergeimasiutin@gmail.com'
git -C "$root" config --local user.signingkey "$key"
git -C "$root" config --local gpg.format ssh
git -C "$root" config --local commit.gpgsign true
git -C "$root" config --local core.sshCommand "ssh -F /dev/null -i '$key' -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"
echo 'Git identity, SSH и подпись настроены только для этого репозитория.'
