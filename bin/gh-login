#!/usr/bin/env bash
set -euo pipefail
umask 077

root="$(cd "$(dirname "$0")/.." && pwd)"
git_directory="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)"
configuration_directory="$git_directory/gh"
version=2.96.0
case "$(uname -m)" in
  arm64|aarch64) architecture=arm64 ;;
  x86_64|amd64) architecture=amd64 ;;
  *) echo 'Архитектура не поддерживается GitHub CLI' >&2; exit 1 ;;
esac

temporary_directory="$(mktemp -d)"
trap 'rm -rf "$temporary_directory"' EXIT
archive="gh_${version}_linux_${architecture}.tar.gz"
release="https://github.com/cli/cli/releases/download/v${version}"
curl --fail --silent --show-error --location "$release/$archive" -o "$temporary_directory/$archive"
curl --fail --silent --show-error --location "$release/gh_${version}_checksums.txt" -o "$temporary_directory/checksums.txt"
(
  cd "$temporary_directory"
  awk -v archive="$archive" '$2 == archive { print }' checksums.txt > selected-checksum.txt
  test -s selected-checksum.txt
  shasum -a 256 --check selected-checksum.txt
)
tar -xzf "$temporary_directory/$archive" -C "$temporary_directory" "gh_${version}_linux_${architecture}/bin/gh"
mkdir "$temporary_directory/config"

# Контейнер не получает доступ к macOS Keychain, глобальному gh и SSH-ключам.
container=(docker run --rm -e GH_CONFIG_DIR=/gh
  --mount "type=bind,src=$temporary_directory/config,dst=/gh"
  --mount "type=bind,src=$temporary_directory/gh_${version}_linux_${architecture}/bin/gh,dst=/usr/local/bin/gh,readonly")
image=ruby:4.0.7-slim
"${container[@]}" -it "$image" gh auth login --hostname github.com --git-protocol ssh --skip-ssh-key --web --insecure-storage
login="$("${container[@]}" "$image" gh api user --jq .login)"
if [[ "$login" != serge-masiutin ]]; then
  echo "GitHub вернул $login; ожидался serge-masiutin. Вход не сохранён." >&2
  exit 1
fi

mkdir -p "$configuration_directory"
chmod 700 "$configuration_directory"
if [[ ! -f "$configuration_directory/config.yml" ]]; then
  install -m 600 "$temporary_directory/config/config.yml" "$configuration_directory/config.yml"
fi
install -m 600 "$temporary_directory/config/hosts.yml" "$configuration_directory/hosts.yml.new"
mv "$configuration_directory/hosts.yml.new" "$configuration_directory/hosts.yml"
echo 'Вход serge-masiutin сохранён только в Git-каталоге проекта. Используй bin/gh.'
